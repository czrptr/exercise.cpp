load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
  name = "lib",
  srcs = glob(["source/lib/**/*.cc"]),
  hdrs = glob(["include/lib/**/*.hh"]),
  strip_include_prefix = "include",
  deps = [
    "@range-v3//:range-v3",
    "@fmt//:fmt",
  ],
  visibility = ["//visibility:public"],
)

cc_library(
  name = "serde",
  srcs = glob(["source/serde/**/*.cc"]),
  hdrs = glob(["include/serde/**/*.hh"]),
  deps = [
    "//:lib",
  ],
  strip_include_prefix = "include",
  visibility = ["//visibility:public"],
)

cc_test(
  name = "test",
  srcs = glob(["test/**/*.hh", "test/**/*.cc"]),
  deps = [
    "//:serde",
    "@com_google_googletest//:gtest_main",
  ],
)
